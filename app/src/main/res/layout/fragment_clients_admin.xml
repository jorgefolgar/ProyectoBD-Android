<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface"
    android:paddingHorizontal="12dp"
    android:paddingTop="10dp">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Muebleria.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/clients_search_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etClientSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvClientsHelper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/clients_helper"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/text_secondary" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressClientsList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/purple_500" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvClientsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="10dp"
        android:paddingBottom="12dp" />
</LinearLayout>

