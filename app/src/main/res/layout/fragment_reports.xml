<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/padding_screen_horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="4dp"
        android:text="@string/reports_screen_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/padding_screen_horizontal"
        android:paddingBottom="8dp"
        android:text="@string/reports_screen_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/text_secondary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/padding_screen_horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="@string/reports_section_sales"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalesByType"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/report_sales_by_type"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                app:strokeColor="@color/outline_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTopProduct"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/report_top_product"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                app:strokeColor="@color/outline_soft" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Muebleria.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/report_purchases_user_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReportUserId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="0" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPurchasesByClient"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/report_purchases_by_client"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                app:strokeColor="@color/outline_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCashClosures"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/report_cash_closures"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                app:strokeColor="@color/outline_soft" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/reports_section_marketing"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarketingBase"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/report_marketing_base"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                app:strokeColor="@color/outline_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarketingLtv"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/report_marketing_ltv"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                app:strokeColor="@color/outline_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarketingActivity"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/report_marketing_activity"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                app:strokeColor="@color/outline_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarketingRetention"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/report_marketing_retention"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                app:strokeColor="@color/outline_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarketingCohort"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/report_marketing_cohort"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                app:strokeColor="@color/outline_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarketingRemarketing"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/report_marketing_remarketing"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                app:strokeColor="@color/outline_soft" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvReportTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/padding_screen_horizontal"
        android:paddingTop="8dp"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="@color/purple_500"
        android:visibility="gone" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressReports"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:indeterminate="true"
        app:indicatorColor="@color/purple_500" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReportData"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp" />
</LinearLayout>
